NODE_ENV=development
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=debug

# Comma-separated frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Upload and model behavior
MAX_IMAGE_SIZE_MB=5
ML_CONFIDENCE_THRESHOLD=0.75
PREDICTOR_PROVIDER=mock
PREDICTOR_URL=http://localhost:8000/predict
ALLOW_MOCK_TARGET_ECHO=true
DYSGRAPHIA_CATALOG_VERSION=2026-06-03

# Reset support for local testing
ENABLE_DEV_RESET=true

# Firebase Admin credentials
FIREBASE_PROJECT_ID=

# Option 1: full JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 2: path to service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option 3: individual fields
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: application default credentials fallback
GOOGLE_APPLICATION_CREDENTIALS=